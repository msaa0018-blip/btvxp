<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Ficha corporativa oficial de VEXPAR OPERACIONES, S.A. DE C.V. en México. Información pública verificada, contratos y documentos oficiales.">
  <meta name="keywords" content="VEXPAR OPERACIONES, México, SA de CV, contratos públicos, IMSS, Guanajuato">
  <meta name="author" content="Ficha Corporativa Pública">
  <meta property="og:title" content="VEXPAR OPERACIONES, S.A. DE C.V. — Ficha Corporativa">
  <meta property="og:description" content="Información pública verificada de VEXPAR OPERACIONES en México.">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <title>VEXPAR OPERACIONES, S.A. DE C.V. — Ficha Corporativa México</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🏢%3C/text%3E%3C/svg%3E">
  <style>
    :root {
      --bg: #fafafa;
      --bg-elevated: #ffffff;
      --bg-muted: #f3f4f6;
      --text-primary: #111827;
      --text-secondary: #4b5563;
      --text-tertiary: #9ca3af;
      --text-quaternary: #d1d5db;
      --border: #e5e7eb;
      --border-strong: #d1d5db;
      --accent: #1f2937;
      --accent-hover: #374151;
      --warning-bg: #fffbeb;
      --warning-border: #f59e0b;
      --warning-text: #92400e;
      --success: #059669;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --radius-xl: 20px;
      --shadow-sm: 0 1px 2px 0 rgba(0,0,0,0.04);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.06), 0 2px 4px -1px rgba(0,0,0,0.03);
      --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.08), 0 4px 6px -2px rgba(0,0,0,0.03);
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
      --font-mono: "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", Consolas, monospace;
      --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0a0a0a;
        --bg-elevated: #141414;
        --bg-muted: #1a1a1a;
        --text-primary: #f5f5f5;
        --text-secondary: #a3a3a3;
        --text-tertiary: #737373;
        --text-quaternary: #525252;
        --border: #262626;
        --border-strong: #404040;
        --accent: #e5e5e5;
        --accent-hover: #ffffff;
        --warning-bg: #291b00;
        --warning-border: #b45309;
        --warning-text: #fbbf24;
        --shadow-sm: 0 1px 2px 0 rgba(0,0,0,0.2);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.3);
        --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.4);
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
    }

    /* ===== NAVIGATION ===== */
    .nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(250,250,250,0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    @media (prefers-color-scheme: dark) {
      .nav { background: rgba(10,10,10,0.85); }
    }
    .nav-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 24px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-brand {
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--text-primary);
      text-decoration: none;
    }
    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }
    .nav-links a {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      letter-spacing: 0.01em;
      transition: var(--transition);
      position: relative;
    }
    .nav-links a:hover { color: var(--text-primary); }
    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 1.5px;
      background: var(--text-primary);
      transition: width 0.25s ease;
    }
    .nav-links a:hover::after { width: 100%; }

    /* ===== HERO ===== */
    .hero {
      text-align: center;
      padding: 80px 24px 60px;
      max-width: 680px;
      margin: 0 auto;
    }
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 100px;
      background: var(--bg-muted);
      border: 1px solid var(--border);
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      letter-spacing: 0.03em;
      margin-bottom: 24px;
    }
    .hero h1 {
      font-size: clamp(32px, 6vw, 48px);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 12px;
    }
    .hero-subtitle {
      font-size: 17px;
      color: var(--text-secondary);
      font-weight: 400;
      margin-bottom: 8px;
    }
    .hero-meta {
      font-size: 14px;
      color: var(--text-tertiary);
    }

    /* ===== SECTIONS ===== */
    .section {
      max-width: 720px;
      margin: 0 auto 48px;
      padding: 0 24px;
    }
    .section-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }
    .section-header svg {
      width: 22px; height: 22px;
      color: var(--text-secondary);
      flex-shrink: 0;
    }
    .section-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: -0.01em;
    }

    /* ===== CARDS ===== */
    .card {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 28px;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
    }
    .card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--border-strong);
    }

    /* ===== INFO GRID ===== */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .info-item {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .info-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .info-value {
      font-size: 15px;
      color: var(--text-primary);
      font-weight: 500;
      word-break: break-word;
      line-height: 1.4;
    }
    .info-value.muted {
      color: var(--text-tertiary);
      font-weight: 400;
    }
    .info-value.tag {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      padding: 4px 10px;
      border-radius: var(--radius-sm);
      background: var(--bg-muted);
      border: 1px solid var(--border);
      font-size: 13px;
      font-weight: 500;
    }

    /* ===== CONTRACTS TABLE ===== */
    .contracts-wrap {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .contracts-header {
      display: grid;
      grid-template-columns: 2.2fr 1fr 0.9fr 0.7fr;
      gap: 16px;
      padding: 14px 20px;
      background: var(--bg-muted);
      border-bottom: 1px solid var(--border);
      font-size: 11px;
      font-weight: 600;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .contract-row {
      display: grid;
      grid-template-columns: 2.2fr 1fr 0.9fr 0.7fr;
      gap: 16px;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
      transition: var(--transition);
      align-items: center;
    }
    .contract-row:last-child { border-bottom: none; }
    .contract-row:hover { background: var(--bg-muted); }
    .contract-row .col-org {
      color: var(--text-primary);
      font-weight: 500;
      line-height: 1.4;
    }
    .contract-row .col-amount {
      color: var(--text-primary);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      font-family: var(--font-mono);
      font-size: 13px;
    }
    .contract-row .col-amount.positive { color: var(--success); }
    .contract-row .col-date {
      color: var(--text-tertiary);
      font-size: 13px;
    }
    .contract-row .col-status {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 100px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .status-awarded {
      background: rgba(5, 150, 105, 0.1);
      color: var(--success);
    }
    .status-pending {
      background: rgba(156, 163, 175, 0.15);
      color: var(--text-secondary);
    }

    /* ===== DOCS LIST ===== */
    .docs-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .doc-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      text-decoration: none;
      color: var(--text-primary);
      font-size: 14px;
      transition: var(--transition);
      box-shadow: var(--shadow-sm);
    }
    .doc-item:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
      transform: translateY(-1px);
    }
    .doc-item svg {
      width: 20px; height: 20px;
      color: var(--text-tertiary);
      flex-shrink: 0;
      transition: var(--transition);
    }
    .doc-item:hover svg { color: var(--text-secondary); }
    .doc-content {
      flex: 1;
      min-width: 0;
    }
    .doc-title {
      font-weight: 500;
      margin-bottom: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .doc-source {
      font-size: 12px;
      color: var(--text-tertiary);
    }
    .doc-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }
    .doc-badge {
      padding: 3px 8px;
      border-radius: var(--radius-sm);
      background: var(--bg-muted);
      border: 1px solid var(--border);
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      font-family: var(--font-mono);
    }
    .doc-arrow {
      color: var(--text-quaternary);
      transition: var(--transition);
    }
    .doc-item:hover .doc-arrow {
      color: var(--text-secondary);
      transform: translateX(2px);
    }

    /* ===== DISCLAIMER ===== */
    .disclaimer {
      display: flex;
      gap: 16px;
      padding: 20px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--warning-border);
      background: var(--warning-bg);
      margin-top: 48px;
    }
    .disclaimer svg {
      width: 22px; height: 22px;
      color: var(--warning-border);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .disclaimer p {
      margin: 0;
      font-size: 13.5px;
      color: var(--warning-text);
      line-height: 1.65;
    }
    .disclaimer strong {
      font-weight: 600;
      color: var(--warning-text);
    }

    /* ===== FOOTER ===== */
    .footer {
      text-align: center;
      padding: 48px 24px;
      border-top: 1px solid var(--border);
      margin-top: 48px;
    }
    .footer p {
      margin: 0;
      font-size: 12px;
      color: var(--text-quaternary);
      letter-spacing: 0.02em;
    }
    .footer-links {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-bottom: 12px;
    }
    .footer-links a {
      font-size: 12px;
      color: var(--text-tertiary);
      text-decoration: none;
      transition: var(--transition);
    }
    .footer-links a:hover { color: var(--text-secondary); }

    /* ===== SCROLLBAR ===== */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-tertiary); }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 640px) {
      .nav-links { display: none; }
      .hero { padding: 56px 20px 40px; }
      .info-grid { grid-template-columns: 1fr; gap: 18px; }
      .contracts-header, .contract-row {
        grid-template-columns: 1fr;
        gap: 6px;
      }
      .contracts-header { display: none; }
      .contract-row { padding: 16px; }
      .contract-row .col-amount::before { content: "Monto: "; color: var(--text-tertiary); font-weight: 400; font-family: var(--font-sans); }
      .contract-row .col-date::before { content: "Fecha: "; color: var(--text-tertiary); font-weight: 400; }
      .contract-row .col-status::before { content: "Estatus: "; color: var(--text-tertiary); font-weight: 400; }
      .doc-item { padding: 12px 14px; }
      .doc-title { white-space: normal; }
      .section { padding: 0 16px; margin-bottom: 36px; }
      .card { padding: 20px; }
    }

    /* ===== ANIMATIONS ===== */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-in {
      animation: fadeInUp 0.6s ease-out forwards;
      opacity: 0;
    }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
  </style>
<base target="_blank">
</head>
<body>

  <!-- NAVIGATION -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="#" class="nav-brand">VEXPAR OPERACIONES</a>
      <ul class="nav-links">
        <li><a href="#corporativo">Corporativo</a></li>
        <li><a href="#contratos">Contratos</a></li>
        <li><a href="#documentos">Documentos</a></li>
        <li><a href="#fuentes">Fuentes</a></li>
      </ul>
    </div>
  </nav>

  <!-- HERO -->
  <header class="hero animate-in">
    <div class="hero-eyebrow">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      Información pública verificada
    </div>
    <h1>VEXPAR OPERACIONES</h1>
    <p class="hero-subtitle">Sociedad Anónima de Capital Variable · México</p>
    <p class="hero-meta">Ficha generada a partir de fuentes oficiales del IMSS y registros públicos</p>
  </header>

  <!-- CORPORATE INFO -->
  <section class="section animate-in delay-1" id="corporativo">
    <div class="section-header">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <h2 class="section-title">Información corporativa</h2>
    </div>
    <div class="card">
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">Razón social</span>
          <span class="info-value">VEXPAR OPERACIONES, S.A. DE C.V.</span>
        </div>
        <div class="info-item">
          <span class="info-label">Tipo de sociedad</span>
          <span class="info-value">Sociedad Anónima de Capital Variable</span>
        </div>
        <div class="info-item">
          <span class="info-label">País de constitución</span>
          <span class="info-value">México</span>
        </div>
        <div class="info-item">
          <span class="info-label">Giro / Sector</span>
          <span class="info-value muted">Servicios / Obras públicas (inferido de contratos)</span>
        </div>
        <div class="info-item">
          <span class="info-label">Sitio web corporativo</span>
          <span class="info-value muted">vexpar.com.mx — no accesible al momento de la consulta</span>
        </div>
        <div class="info-item">
          <span class="info-label">RFC</span>
          <span class="info-value muted">No disponible en fuentes públicas abiertas</span>
        </div>
        <div class="info-item">
          <span class="info-label">Registro Público</span>
          <span class="info-value muted">No localizado en consulta abierta</span>
        </div>
        <div class="info-item">
          <span class="info-label">Representante legal</span>
          <span class="info-value muted">No disponible públicamente</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTRACTS -->
  <section class="section animate-in delay-2" id="contratos">
    <div class="section-header">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
        <polyline points="10 9 9 9 8 9"/>
      </svg>
      <h2 class="section-title">Contratos públicos verificados</h2>
    </div>
    <div class="contracts-wrap">
      <div class="contracts-header">
        <span>Institución / Proceso</span>
        <span>Monto</span>
        <span>Fecha</span>
        <span>Estatus</span>
      </div>
      <div class="contract-row">
        <span class="col-org">IMSS OOAD Guanajuato — Acta de Fallo N-46</span>
        <span class="col-amount positive">$137,209.14 MXN</span>
        <span class="col-date">Marzo 2026</span>
        <span class="col-status status-awarded">Adjudicado</span>
      </div>
      <div class="contract-row">
        <span class="col-org">IMSS OOAD Guanajuato — Junta de Aclaraciones N-31</span>
        <span class="col-amount">—</span>
        <span class="col-date">Enero 2026</span>
        <span class="col-status status-pending">No adjudicado</span>
      </div>
    </div>
    <p style="margin-top: 12px; font-size: 12px; color: var(--text-tertiary);">
      Fuente: Repositorio de Contrataciones del IMSS — OOAD Guanajuato, 1er Trimestre 2026.
    </p>
  </section>

  <!-- DOCUMENTS -->
  <section class="section animate-in delay-3" id="documentos">
    <div class="section-header">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      <h2 class="section-title">Documentos oficiales enlazados</h2>
    </div>
    <div class="docs-list">
      <a class="doc-item" href="https://reposipot.imss.gob.mx/OOAD/GUANAJUATO/1er%20Trimestre%202026/Fallos/ACTA%20FALLO%20N-46%20MARZO.pdf" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        <div class="doc-content">
          <div class="doc-title">Acta de Fallo N-46 — Marzo 2026</div>
          <div class="doc-source">IMSS OOAD Guanajuato / Repositorio de Fallos</div>
        </div>
        <div class="doc-meta">
          <span class="doc-badge">PDF</span>
          <svg class="doc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </div>
      </a>

      <a class="doc-item" href="https://reposipot.imss.gob.mx/OOAD/GUANAJUATO/1er%20Trimestre%202026/Junta%20de%20Aclaraciones/JA%20N31%2026.pdf" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        <div class="doc-content">
          <div class="doc-title">Junta de Aclaraciones N-31 — Enero 2026</div>
          <div class="doc-source">IMSS OOAD Guanajuato / Juntas de Aclaraciones</div>
        </div>
        <div class="doc-meta">
